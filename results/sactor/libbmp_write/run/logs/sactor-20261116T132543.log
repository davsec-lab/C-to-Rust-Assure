static int get_now(struct timespec *ts)
{
#if defined(CLOCK_MONOTONIC)
	return clock_gettime(CLOCK_MONOTONIC, ts);
#else
	struct timeval tv;

	if (gettimeofday(&tv, NULL) != 0)
	{
		return -1;
	}

	ts->tv_sec = tv.tv_sec;
	ts->tv_nsec = (long) tv.tv_usec * 1000L;
	return 0;
#endif
}
```

