   else if (cb1) \
     cb1(p->entry_buf, entry_pos, data); \
   pstate = FIELD_NOT_BEGUN; \
   entry_pos = quoted = spaces = 0; \
 } while (0)
#define FIELD_BEGUN             2
#define CSV_STRICT_FINI 4
#define CSV_STRICT 1
#define CSV_APPEND_NULL 8
#define CSV_EMPTY_IS_NULL 16
