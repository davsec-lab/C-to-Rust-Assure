                b"%5d \0".as_ptr() as *const libc::c_char,
                *row.offset(j as isize) as libc::c_int,
            );
            j += 1;
        }
        libc::printf(b"\n\0".as_ptr() as *const libc::c_char);
        i += 1;
    }
    libc::printf(b"\n\0".as_ptr() as *const libc::c_char);
}

