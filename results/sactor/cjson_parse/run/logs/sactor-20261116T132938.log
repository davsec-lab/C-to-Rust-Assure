```rust
pub fn cJSON_Delete(item: Option<Box<cJSON>>) {
    let mut current = item;
    while let Some(mut node) = current {
        // Detach the next node first so dropping this node does not recurse along the list.
        current = node.next.take();
        // Child, valuestring, and string are owned and are dropped with the node.
        drop(node);
    }
}
```
