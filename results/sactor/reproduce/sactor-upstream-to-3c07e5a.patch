+struct IdentCollector {
+    idents: HashSet<String>,
+}
+
+impl<'ast> Visit<'ast> for IdentCollector {
+    fn visit_ident(&mut self, i: &'ast syn::Ident) {
+        self.idents.insert(i.to_string());
+    }
+}
+
+fn collect_idents(item: &syn::Item) -> HashSet<String> {
+    let mut collector = IdentCollector {
+        idents: HashSet::new(),
+    };
+    collector.visit_item(item);
+    collector.idents
+}
+
+/// Keep only the prefix `type` / `const` items that `target` (transitively) references;
+/// `use` items are always kept. Copying every alias blindly drags in items such as
+/// `pub type FILE = _IO_FILE;` whose right-hand side is not part of the extracted code,
+/// which makes every consumer of the struct fail to compile.
+fn prune_prefix_items(prefix_items: Vec<syn::Item>, target: &syn::Item) -> Vec<syn::Item> {
+    let mut needed = collect_idents(target);
+    let mut selected = vec![false; prefix_items.len()];
+    loop {
+        let mut changed = false;
+        for (idx, item) in prefix_items.iter().enumerate() {
+            if selected[idx] {
+                continue;
+            }
+            let keep = match item {
+                syn::Item::Use(_) => true,
+                syn::Item::Type(t) => needed.contains(&t.ident.to_string()),
+                syn::Item::Const(c) => needed.contains(&c.ident.to_string()),
+                _ => false,
+            };
+            if keep {
+                selected[idx] = true;
+                changed = true;
+                needed.extend(collect_idents(item));
+            }
+        }
+        if !changed {
+            break;
+        }
+    }
+    prefix_items
+        .into_iter()
+        .zip(selected)
+        .filter(|(_, keep)| *keep)
+        .map(|(item, _)| item)
+        .collect()
+}
+
