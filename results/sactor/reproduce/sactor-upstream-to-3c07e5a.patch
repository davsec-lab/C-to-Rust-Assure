+# Local overrides for this machine. Defaults live in sactor/_resources/sactor.default.toml.
+[general]
+model = "gpt-4o"
+encoding = "o200k_base"
+
+[logging]
+console_level = "INFO"
+file_level = "DEBUG"
+
+[litellm]
+[litellm.router_settings]
+routing_strategy = "simple-shuffle"
+num_retries = 2
+timeout = 600
+
+# Anthropic (key from ~/.zshrc: ANTHROPIC_API_KEY)
+[[litellm.model_list]]
