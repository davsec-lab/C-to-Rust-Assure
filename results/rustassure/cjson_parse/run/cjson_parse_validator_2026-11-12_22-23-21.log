    let mut digits = 0usize;
    while p < n && s[p].is_ascii_digit() {
        p += 1;
        digits += 1;
    }
    if p < n && s[p] == decimal_point {
        p += 1;
        while p < n && s[p].is_ascii_digit() {
            p += 1;
            digits += 1;
        }
