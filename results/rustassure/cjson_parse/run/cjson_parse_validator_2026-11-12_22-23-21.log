    if utf8_length > 1 {
        output[0] = ((codepoint | first_byte_mark as u64) & 0xFF) as u8;
    } else {
        output[0] = (codepoint & 0x7F) as u8;
    }

    let taken = std::mem::take(output);
    *output = &mut taken[utf8_length as usize..];

    sequence_length
