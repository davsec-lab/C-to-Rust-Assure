use std::io::Read;
use std::time::Instant;

fn read_full(fp: &mut std::fs::File, buf: &mut [u8]) -> usize {
    let mut total = 0;
    while total < buf.len() {
        match fp.read(&mut buf[total..]) {
            Ok(0) => break,
            Ok(n) => total += n,
            Err(ref e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
            Err(_) => break,
        }
    }
    total
}

