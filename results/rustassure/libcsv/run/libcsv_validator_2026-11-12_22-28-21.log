            let time_elapsed = diff_timespec(&end_time, &start_time);
            println!("Time taken to parse csv {}: {:.6} seconds", name, time_elapsed);
            println!("{} well-formed", name);
        }
        drop(fp);
        csv_fini(Some(&mut p), None, None);
    }

    csv_free(Some(&mut p));
}
