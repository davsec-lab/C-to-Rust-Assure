pub fn bmp_header_write(
    header: Option<&BmpHeader>,
    img_file: Option<&mut dyn Write>,
) -> bmp_error {
    let header = match header {
        None => return bmp_error::BMP_HEADER_NOT_INITIALIZED,
        Some(h) => h,
    };
