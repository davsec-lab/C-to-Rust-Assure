        None => return bmp_error::BMP_FILE_NOT_OPENED,
        Some(f) => f,
    };

    let magic: u16 = 19778;
    let _ = img_file.write_all(&magic.to_le_bytes());

    let mut buf: Vec<u8> = Vec::with_capacity(52);
    buf.extend_from_slice(&header.bf_size.to_le_bytes());
