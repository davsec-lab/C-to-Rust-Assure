    fft_transform_radix2(&mut avec, m as size_t, true);
    for i in 0..nn {
        let k = (i * i) % (2 * nn);
        let angle = (if inverse { pi } else { -pi }) * (k as f64) / (nn as f64);
        let omega = (angle.cos(), angle.sin());
        let p = cmul(avec[i], omega);
        vec[i] = (p.0 / (m as f64), p.1 / (m as f64));
    }
