void fft_transform_radix2(double _Complex* vec, size_t n, _Bool inverse);

void fft_transform_radix2(double _Complex* vec, size_t n, _Bool inverse) {
 int levels = 0;
 for (size_t k = 1; (k & n) == 0; k <<= 1)
  levels++;
 for (size_t i = 0; i < n; i++) {
  size_t j = 0, ii = i;
  for (int k = 0; k < levels; k++) {
   j = (j << 1) | (ii & 1);
   ii >>= 1;
  }
  if (j > i) {
   double _Complex tmp = vec[i];
   vec[i] = vec[j];
   vec[j] = tmp;
  }
 }
