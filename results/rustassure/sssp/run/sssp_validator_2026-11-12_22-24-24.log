```rust
#[derive(Debug, Clone, Default)]
pub struct Graph {
    pub nodes: Vec<Node>,
    pub edges: Vec<Edge>,
}

impl Graph {
    /// Equivalent of allocating `node_count` nodes with ids 0..node_count
    /// and an empty edge list.
    pub fn new(node_count: usize) -> Self {
        Graph {
            nodes: (0..node_count).map(|i| Node::new(i as i32)).collect(),
            edges: Vec::new(),
        }
    }

    /// Equivalent of `node_count`
    pub fn node_count(&self) -> usize {
        self.nodes.len()
    }

    /// Equivalent of `edge_count`
    pub fn edge_count(&self) -> usize {
        self.edges.len()
    }

    /// Equivalent of `capacity` (edge array capacity)
    pub fn capacity(&self) -> usize {
        self.edges.capacity()
    }

    /// Replaces the realloc + index assignment pattern for edges.
    pub fn add_edge(&mut self, from: i32, to: i32, weight: i32) {
        self.edges.push(Edge { from, to, weight });
    }
}
```

