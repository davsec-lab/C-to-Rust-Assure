                *cdest = *csrc;
                cdest = cdest.add(1);
            }
            if chars < usize::MAX {
                chars += 1;
            }

            src_size -= 1;
            csrc = csrc.add(1);
        }

        if dest_size > chars {
            *cdest = quote;
        }
        if chars < usize::MAX {
            chars += 1;
        }
    }

    chars
}
