pub fn csv_write2(
    dest: Option<&mut [u8]>,
    src: Option<&[u8]>,
    quote: u8,
) -> usize {
    let Some(src) = src else {
        return 0;
    };

    let mut chars = 0usize;

    if let Some(buffer) = dest.as_deref_mut() {
        if !buffer.is_empty() {
            buffer[0] = quote;
        }
    }
    chars = chars.saturating_add(1);

    for &byte in src {
        if byte == quote {
            if let Some(buffer) = dest.as_deref_mut() {
                if chars < buffer.len() {
                    buffer[chars] = quote;
                }
            }
            chars = chars.saturating_add(1);
        }

        if let Some(buffer) = dest.as_deref_mut() {
            if chars < buffer.len() {
                buffer[chars] = byte;
            }
        }
        chars = chars.saturating_add(1);
    }

    if let Some(buffer) = dest.as_deref_mut() {
        if chars < buffer.len() {
            buffer[chars] = quote;
        }
    }
    chars.saturating_add(1)
}
