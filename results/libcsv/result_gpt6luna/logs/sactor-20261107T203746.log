----FUNCTION----
```rust
pub fn csv_parse(
    p: &mut CsvParser<'_>,
    s: &[u8],
    cb1: Option<unsafe extern "C" fn(*mut core::ffi::c_void, usize, *mut core::ffi::c_void)>,
    cb2: Option<unsafe extern "C" fn(i32, *mut core::ffi::c_void)>,
    data: *mut core::ffi::c_void,
) -> usize {
    fn save_state(
        p: &mut CsvParser<'_>,
        quoted: i32,
        pstate: i32,
        spaces: usize,
        entry_pos: usize,
    ) {
        p.quoted = quoted;
        p.pstate = pstate;
        p.spaces = spaces;
        p.entry_pos = entry_pos;
    }

    fn put_byte(p: &mut CsvParser<'_>, index: usize, byte: u8) {
        p.entry_buf
            .as_deref_mut()
            .expect("CSV entry buffer is not allocated")[index] = byte;
    }

    fn emit_field(
        p: &mut CsvParser<'_>,
        entry_pos: usize,
        quoted: i32,
        cb1: Option<
            unsafe extern "C" fn(*mut core::ffi::c_void, usize, *mut core::ffi::c_void),
        >,
        data: *mut core::ffi::c_void,
    ) {
        if p.options & 8 != 0 {
            put_byte(p, entry_pos, 0);
        }

        if let Some(callback) = cb1 {
            let entry_ptr = if p.options & 16 != 0 && quoted == 0 && entry_pos == 0 {
                core::ptr::null_mut()
            } else {
                p.entry_buf
                    .as_deref_mut()
                    .expect("CSV entry buffer is not allocated")
                    .as_mut_ptr()
                    .cast()
            };

            // Calling a C callback is inherently unsafe.
            unsafe {
                callback(entry_ptr, entry_pos, data);
            }
        }
    }

    let delim = p.delim_char;
    let quote = p.quote_char;
    let is_space = p.is_space;
    let is_term = p.is_term;
    let mut quoted = p.quoted;
    let mut pstate = p.pstate;
    let mut spaces = p.spaces;
    let mut entry_pos = p.entry_pos;
    let mut pos = 0;

    let is_space_char = |c: u8| match is_space {
        Some(predicate) => {
            // Calling a C predicate is inherently unsafe.
            unsafe { predicate(c) != 0 }
        }
        None => c == 0x20 || c == 0x09,
    };

    let is_term_char = |c: u8| match is_term {
        Some(predicate) => {
            // Calling a C predicate is inherently unsafe.
            unsafe { predicate(c) != 0 }
        }
        None => c == 0x0d || c == 0x0a,
    };

    if p.entry_buf.is_none() && pos < s.len() && csv_increase_buffer(Some(&mut *p)) != 0 {
        save_state(p, quoted, pstate, spaces, entry_pos);
        return pos;
    }

    while pos < s.len() {
        let entry_limit = if p.options & 8 != 0 {
            p.entry_size.wrapping_sub(1)
        } else {
            p.entry_size
        };

        if entry_pos == entry_limit && csv_increase_buffer(Some(&mut *p)) != 0 {
            save_state(p, quoted, pstate, spaces, entry_pos);
            return pos;
        }

        let c = s[pos];
        pos += 1;

        match pstate {
            0 | 1 => {
                let space = is_space_char(c);
                let term = is_term_char(c);

                if space && c != delim {
                    continue;
                } else if term {
                    if pstate == 1 {
                        if quoted == 0 {
                            entry_pos = entry_pos.wrapping_sub(spaces);
                        }
                        emit_field(p, entry_pos, quoted, cb1, data);

                        pstate = 1;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;

                        if let Some(callback) = cb2 {
                            // Calling a C callback is inherently unsafe.
                            unsafe { callback(c as i32, data) };
                        }

                        pstate = 0;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                    } else if p.options & 2 != 0 {
                        if let Some(callback) = cb2 {
                            // Calling a C callback is inherently unsafe.
                            unsafe { callback(c as i32, data) };
                        }
                        pstate = 0;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                    }
                    continue;
                } else if c == delim {
                    if quoted == 0 {
                        entry_pos = entry_pos.wrapping_sub(spaces);
                    }
                    emit_field(p, entry_pos, quoted, cb1, data);
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                } else if c == quote {
                    pstate = 2;
                    quoted = 1;
                } else {
                    pstate = 2;
                    quoted = 0;
                    put_byte(p, entry_pos, c);
                    entry_pos += 1;
                }
            }
            2 => {
                if c == quote {
                    if quoted != 0 {
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                        pstate = 3;
                    } else {
                        if p.options & 1 != 0 {
                            p.status = 1;
                            save_state(p, quoted, pstate, spaces, entry_pos);
                            return pos.wrapping_sub(1);
                        }
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                        spaces = 0;
                    }
                } else if c == delim {
                    if quoted != 0 {
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                    } else {
                        entry_pos = entry_pos.wrapping_sub(spaces);
                        emit_field(p, entry_pos, quoted, cb1, data);
                        pstate = 1;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                    }
                } else {
                    let term = is_term_char(c);
                    let space = is_space_char(c);

                    if term {
                        if quoted == 0 {
                            entry_pos = entry_pos.wrapping_sub(spaces);
                            emit_field(p, entry_pos, quoted, cb1, data);
                            pstate = 1;
                            entry_pos = 0;
                            quoted = 0;
                            spaces = 0;

                            if let Some(callback) = cb2 {
                                // Calling a C callback is inherently unsafe.
                                unsafe { callback(c as i32, data) };
                            }

                            pstate = 0;
                            entry_pos = 0;
                            quoted = 0;
                            spaces = 0;
                        } else {
                            put_byte(p, entry_pos, c);
                            entry_pos += 1;
                        }
                    } else if quoted == 0 && space {
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                        spaces += 1;
                    } else {
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                        spaces = 0;
                    }
                }
            }
            3 => {
                let term = is_term_char(c);

                if c == delim {
                    entry_pos = entry_pos.wrapping_sub(spaces).wrapping_sub(1);
                    emit_field(p, entry_pos, quoted, cb1, data);
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                } else if term {
                    entry_pos = entry_pos.wrapping_sub(spaces).wrapping_sub(1);
                    emit_field(p, entry_pos, quoted, cb1, data);
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;

                    if let Some(callback) = cb2 {
                        // Calling a C callback is inherently unsafe.
                        unsafe { callback(c as i32, data) };
                    }

                    pstate = 0;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                } else if is_space_char(c) {
                    put_byte(p, entry_pos, c);
                    entry_pos += 1;
                    spaces += 1;
                } else if c == quote {
                    if spaces != 0 {
                        if p.options & 1 != 0 {
                            p.status = 1;
                            save_state(p, quoted, pstate, spaces, entry_pos);
                            return pos.wrapping_sub(1);
                        }
                        spaces = 0;
                        put_byte(p, entry_pos, c);
                        entry_pos += 1;
                    } else {
                        pstate = 2;
                    }
                } else {
                    if p.options & 1 != 0 {
                        p.status = 1;
                        save_state(p, quoted, pstate, spaces, entry_pos);
                        return pos.wrapping_sub(1);
                    }
                    pstate = 2;
                    spaces = 0;
                    put_byte(p, entry_pos, c);
                    entry_pos += 1;
                }
            }
            _ => {}
        }
    }

    save_state(p, quoted, pstate, spaces, entry_pos);
    pos
}
