pub fn csv_free(parser: &mut CsvParser<'_>) {
    let entry_buf = parser.entry_buf.take();

    if let (Some(mut entry_buf), Some(free_func)) = (entry_buf, parser.free_func) {
        let ptr = entry_buf
            .as_mut_ptr()
            .cast::<core::ffi::c_void>();
        drop(entry_buf);

        unsafe {
            free_func(ptr);
        }
    }

    parser.entry_size = 0;
}
