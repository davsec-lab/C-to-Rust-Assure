                        entry_pos = entry_pos.wrapping_add(1);
                        spaces = spaces.wrapping_add(1);
                    } else {
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = c;
                        entry_pos = entry_pos.wrapping_add(1);
                        spaces = 0;
                    }
                }
            }
            3 => {
                let is_term_char = match is_term {
                    Some(f) => unsafe { f(c) != 0 }
                    None => c == 0x0d || c == 0x0a,
                };
                if c == delim {
                    entry_pos = entry_pos.wrapping_sub(spaces).wrapping_sub(1);
                    if p.options & 8 != 0 {
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = 0;
                    }
                    emit_entry!();
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                } else if is_term_char {
                    entry_pos = entry_pos.wrapping_sub(spaces).wrapping_sub(1);
                    if p.options & 8 != 0 {
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = 0;
                    }
                    emit_entry!();
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                    emit_row!(c);
                    pstate = 0;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
                } else {
                    let is_space_char = match is_space {
                        Some(f) => unsafe { f(c) != 0 }
                        None => c == 0x20 || c == 0x09,
                    };
                    if is_space_char {
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = c;
                        entry_pos = entry_pos.wrapping_add(1);
                        spaces = spaces.wrapping_add(1);
                    } else if c == quote {
