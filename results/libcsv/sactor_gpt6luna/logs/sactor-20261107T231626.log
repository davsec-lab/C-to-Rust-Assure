                            spaces = 0;
                            emit_row!(c);
                            pstate = 0;
                            entry_pos = 0;
                            quoted = 0;
                            spaces = 0;
                        } else {
                            p.entry_buf.as_deref_mut().unwrap()[entry_pos] = c;
                            entry_pos = entry_pos.wrapping_add(1);
                        }
                    } else if quoted == 0 && is_space_char {
