                        }
                    } else {
                        if p.options & 1 != 0 {
                            p.status = 1;
                            save_state!();
                            return pos.wrapping_sub(1);
                        }
                        pstate = 2;
                        spaces = 0;
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = c;
                        entry_pos = entry_pos.wrapping_add(1);
                    }
                }
            }
            _ => {}
        }
    }
    save_state!();
    pos
}

