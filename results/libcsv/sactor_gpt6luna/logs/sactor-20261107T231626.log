                        }
                        if p.options & 8 != 0 {
                            p.entry_buf.as_deref_mut().unwrap()[entry_pos] = 0;
                        }
                        emit_entry!();
                        pstate = 1;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                        emit_row!(c);
                        pstate = 0;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                    } else if p.options & 2 != 0 {
                        emit_row!(c);
                        pstate = 0;
                        entry_pos = 0;
                        quoted = 0;
                        spaces = 0;
                    }
                    continue;
                } else if c == delim {
                    if quoted == 0 {
                        entry_pos = entry_pos.wrapping_sub(spaces);
                    }
                    if p.options & 8 != 0 {
                        p.entry_buf.as_deref_mut().unwrap()[entry_pos] = 0;
                    }
                    emit_entry!();
                    pstate = 1;
                    entry_pos = 0;
                    quoted = 0;
                    spaces = 0;
