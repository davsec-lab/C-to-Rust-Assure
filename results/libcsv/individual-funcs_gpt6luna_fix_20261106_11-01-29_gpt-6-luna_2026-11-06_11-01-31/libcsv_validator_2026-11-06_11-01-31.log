* 1000 + (t1.tv_nsec - t0.tv_nsec) / 1_000_000\n}\n\nfn main() {\n    let args: Vec<std::ffi::OsString> = std::env::args_os().collect();\n    if args.len() < 2 {\n        let program = args.first().map(|s| s.to_string_lossy()).unwrap_or_default();\n        eprintln!("Usage: {} <csv_file>", program);\n        std::process::exit(1);\n    }\n\n    let input_path = &args[1];\n    let path_c = match CString::new(input_path.as_os_str().as_bytes()) {\n        Ok(path) => path,\n        Err(_) => {\n            eprintln!("Failed to open {}", input_path.to_string_lossy());\n            std::process::exit(1);\n        }\n    };\n\n    unsafe {\n        let fp = libc::fopen(path_c.as_ptr(), b"rb\\0".as_ptr().cast());\n        if fp.is_null() {\n            eprintln!("Failed to open {}", input_path.to_string_lossy());\n            std::process::exit(1);\n        }\n\n        let mut parser = std::mem::MaybeUninit::<csv_parser>::uninit();\n        if csv_init(parser.as_mut_ptr(), 1) != 0 {\n            eprintln!("csv_init failed");\n            libc::fclose(fp);\n            std::process::exit(1);\n        }\n        let mut parser = parser.assume_init();\n\n        let mut buf = [0u8; 4096];\n        let mut total_bytes: usize = 0;\n        let mut ok = true;\n        let mut t0 = std::mem::MaybeUninit::<libc::timespec>::uninit();\n        let mut t1 = std::mem::MaybeUninit::<libc::timespec>::uninit();\n\n        if get_now(t0.as_mut_ptr().as_mut().unwrap()) != 0 {\n            eprintln!("time start failed");\n            csv_free(&mut parser);\n            libc::fclose(fp);\n            std::process::exit(1);\n        }\n        let t0 = t0.assume_init();\n\n        loop {\n            let got = libc::fread(buf.as_mut_ptr().cast(), 1, buf.len(), fp);\n            if got == 0 {\n                if libc::ferror(fp) != 0 {\n                    eprintln!("Read failed");\n                    ok = false;\n                }\n                break;\n            }\n\n            let consumed = csv_parse(\n                &mut parser,\n                buf.as_ptr().cast(),\n                got,\n                None,\n                None,\n                std::ptr::null_mut(),\n            );\n            total_bytes += consumed;\n            if consumed != got {\n                ok = false;\n                eprintln!(\n                    "Malformed CSV at byte {} (csv_error={})",\n                    total_bytes + 1,\n                    csv_error(&parser)\n                );\n                break;\n            }\n        }\n\n        if ok && csv_fini(&mut parser, None, None, std::ptr::null_mut()) != 0 {\n            ok = false;\n            eprintln!("csv_fini failed (csv_error={})", csv_error(&parser));\n        }\n\n        if get_now(t1.as_mut_ptr().as_mut().unwrap()) != 0 {\n            eprintln!("time end failed");\n            csv_free(&mut parser);\n            libc::fclose(fp);\n            std::process::exit(1);\n        }\n        let t1 = t1.assume_init();\n\n        libc::fclose(fp);\n\n        if ok {\n            println!("well-formed");\n        }\n        println!("bytes_processed: {}", total_bytes);\n        println!("elapsed_ms: {}", elapsed_ms_since(&t0, &t1));\n\n        std::process::exit(if ok { 0 } else { 2 });\n    }\n}', type='output_text', logprobs=[])], role='assistant', status='completed', type='message', phase='final_answer')], parallel_tool_calls=True, temperature=1.0, tool_choice='auto', tools=[], top_p=0.98, max_output_tokens=128000, previous_response_id=None, reasoning=Reasoning(effort='low', generate_summary=None, context='all_turns', mode='standard', summary='detailed'), status='completed', text=ResponseTextConfig(format=ResponseFormatText(type='text'), verbosity='medium'), truncation='disabled', usage=ResponseUsage(input_tokens=5464, input_tokens_details=InputTokensDetails(cached_tokens=0, cache_write_tokens=5461), output_tokens=1124, output_tokens_details=OutputTokensDetails(reasoning_tokens=229), total_to