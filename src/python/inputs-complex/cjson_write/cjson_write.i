    if (root != ((void*)0))
    {
        for (const cJSON *item = root->child; item != ((void*)0); item = item->next)
        {
            entry_count++;
            if (item->string != ((void*)0))
            {
                for (const char *p = item->string; *p != '\0'; p++)
                {
                    checksum = checksum * 131u + (unsigned char)*p;
                }
            }
            checksum = checksum * 131u + (unsigned char)'=';
            if (item->valuestring != ((void*)0))
            {
                for (const char *p = item->valuestring; *p != '\0'; p++)
                {
                    checksum = checksum * 131u + (unsigned char)*p;
                }
            }
            checksum = checksum * 131u + (unsigned char)';';
        }
    }
    printf("create_objects entries: %d\n", entry_count);
    printf("Checksum: %llu\n", checksum);
}
int test_create_objects(char **keys, char **values, int size)
{
    cJSON *root = create_objects(keys, values, size);
    if (root == ((void*)0))
    {
        printf("test_create_objects failed: create_objects returned NULL.\n");
        return -1;
    }
    printf("create_objects JSON:\n");
    print_json_object(root);
    cJSON_Delete(root);
    return 0;
}
int main(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <iterations> <size>\n", argv[0]);
        return 1;
    }
    int iterations = atoi(argv[1]);
    int size = atoi(argv[2]);
    if (iterations <= 0 || size <= 0)
    {
        printf("Invalid number of iterations or size. Please enter positive integers.\n");
        return 1;
    }
    srand(42);
    char **keys = (char **)malloc(size * sizeof(char *));
    char **values = (char **)malloc(size * sizeof(char *));
    if (keys == ((void*)0) || values == ((void*)0))
    {
        printf("Memory allocation failed.\n");
        return 1;
    }
    for (int i = 0; i < size; i++)
    {
        char *key_str = (char *)malloc(11);
        if (key_str == ((void*)0)) { printf("Memory allocation failed.\n"); return 1; }
        for (int j = 0; j < 10; j++) key_str[j] = 'a' + rand() % 26;
        key_str[10] = '\0';
        keys[i] = key_str;
        char *val_str = (char *)malloc(11);
        if (val_str == ((void*)0)) { printf("Memory allocation failed.\n"); return 1; }
        for (int j = 0; j < 10; j++) val_str[j] = 'a' + rand() % 26;
        val_str[10] = '\0';
        values[i] = val_str;
    }
    if (test_create_objects(keys, values, size) != 0)
    {
        for (int i = 0; i < size; i++)
        {
            free(keys[i]);
            free(values[i]);
        }
        free(keys);
        free(values);
        return 1;
    }
    struct timespec start_time;
    struct timespec end_time;
    clock_gettime(1, &start_time);
    for (int i = 0; i < iterations; i++) {
        cJSON *root = create_objects(keys, values, size);
        cJSON_Delete(root);
    }
    clock_gettime(1, &end_time);
    double elapsed_seconds = (double)(end_time.tv_sec - start_time.tv_sec) +
                             (double)(end_time.tv_nsec - start_time.tv_nsec) / 1000000000.0;
    printf("elapsed_time_seconds: %.6f\n", elapsed_seconds);
    for (int i = 0; i < size; i++)
    {
        free(keys[i]);
        free(values[i]);
    }
    free(keys);
    free(values);
    return 0;
}
