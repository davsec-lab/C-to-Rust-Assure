static int
count_parens(char *s, int len)
{
 int pcount = 0, bcount = 0, ccount = 0;
 for (int i = 0; i < len && s[i]; i++) {
  switch (s[i]) {
   case '(': pcount++; break;
   case '[': bcount++; break;
   case '{': ccount++; break;
   case ')': pcount--; break;
   case ']': bcount--; break;
   case '}': ccount--; break;
  }
 }
 if (pcount)
  return pcount;
 if (bcount)
  return bcount;
 return ccount;
}
static char *
read_file(char *fname)
{
