 Val v = ((void*)0);
 Tsp st = tisp_env_init(1024);
 tib_env_core(st);
 tib_env_math(st);
 tib_env_io(st);
 tib_env_os(st);
 tib_env_string(st);
 tisp_env_lib(st, tibs);
 struct sigaction sigint;
 sigint.__sigaction_handler.sa_handler = ((__sighandler_t) 1);
 sigaction(2, &sigint, ((void*)0));
 if (argc == 1) {
  st->file = "(repl)";
  goto readstr;
 }
 for (; i < argc; i++, v = ((void*)0)) {
  if (argv[i][0] == '-') {
   if (argv[i][1] == 'c') {
    if (!(st->file = argv[++i])) {
     fputs("tisp: expected command after -c\n", stderr);
     exit(2);
    }
readstr:
    if ((v = tisp_read(st)))
     v = tisp_eval(st, st->env, v);
   } else if (argv[i][1] == 'r') {
    st->file = "(repl)";
    if ((v = tisp_read(st)))
     v = tisp_eval(st, st->env, v);
   } else if (argv[i][1] == 'v') {
    fprintf(stderr, "tisp v%s (c) 2017-2025 Ed van Bruggen\n", "0.1");
    exit(0);
   } else if (argv[i][1]) {
    fputs("usage: tisp [-hrv] [-c COMMAND] [-] [FILE ...]\n", stderr);
    exit(argv[i][1] == 'h' ? 0 : 1);
   } else {
    v = read_parse_eval(st, st->nil);
   }
  } else {
   v = read_parse_eval(st, mk_pair(mk_str(st, argv[i]), st->nil));
  }
  if (v && v->t != TSP_NONE)
   tisp_print(stdout, v);
 }
  puts("");
 return 0;
}
