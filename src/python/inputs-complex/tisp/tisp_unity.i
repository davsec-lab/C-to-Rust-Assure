 int len = 0, n, fd, parens = 0;
 if (!fname)
  fd = 0;
 else if ((fd = open(fname, 00)) < 0)
  do { fprintf(stderr, "; tisp: error: " "could not find file '%s'" "\n", fname); return ((void*)0); } while(0);
 while ((n = read(fd, buf, sizeof(buf))) > 0) {
  file = realloc(file, len + n + 1);
  if (!file) perror("; realloc"), exit(1);
  memcpy(file + len, buf, n);
  len += n;
  file[len] = '\0';
  if (fd == 0 && (parens += count_parens(buf, n)) <= 0)
   break;
 }
 if (fd)
  close(fd);
 if (n < 0)
  do { fprintf(stderr, "; tisp: error: " "could not read file '%s'" "\n", fname); return ((void*)0); } while(0);
 return file;
}
