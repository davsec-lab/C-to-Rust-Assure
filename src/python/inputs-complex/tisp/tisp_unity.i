 case TSP_NONE:
  fputs("Void", f);
  break;
 case TSP_NIL:
  fputs("Nil", f);
  break;
 case TSP_INT:
  fprintf(f, "%d", (int) ((v)->v.n.num));
  break;
 case TSP_DEC:
  fprintf(f, "%.15g", ((v)->v.n.num));
  if (((v)->v.n.num) == (int)((v)->v.n.num))
   fprintf(f, ".0");
  break;
 case TSP_RATIO:
  fprintf(f, "%d/%d", (int)((v)->v.n.num), (int)((v)->v.n.den));
  break;
 case TSP_STR:
 case TSP_SYM:
  fputs(v->v.s, f);
  break;
 case TSP_FUNC:
 case TSP_MACRO:
  fprintf(f, "#<%s%s%s>",
              v->t == TSP_FUNC ? "function" : "macro",
              v->v.f.name ? ":" : "",
              v->v.f.name ? v->v.f.name : "");
  break;
 case TSP_PRIM:
  fprintf(f, "#<primitive:%s>", v->v.pr.name);
  break;
 case TSP_FORM:
  fprintf(f, "#<form:%s>", v->v.pr.name);
  break;
 case TSP_REC:
  putc('{', f);
  for (Rec r = v->v.r; r; r = r->next)
   for (int i = 0, c = 0; c < r->size; i++)
    if (r->items[i].key) {
     c++;
     fprintf(f, " %s: ", r->items[i].key);
     tisp_print(f, r->items[i].val);
    } else if (c == 64) {
     fputs(" ...", f);
     break;
    }
  fputs(" }", f);
  break;
 case TSP_PAIR:
  putc('(', f);
  tisp_print(f, ((v)->v.p.car));
  for (v = ((v)->v.p.cdr); !((v)->t == TSP_NIL); v = ((v)->v.p.cdr)) {
   if (v->t == TSP_PAIR) {
    putc(' ', f);
    tisp_print(f, ((v)->v.p.car));
   } else {
    fputs(" . ", f);
    tisp_print(f, v);
    break;
   }
  }
  putc(')', f);
  break;
